generator client {
  provider        = "prisma-client"
  output          = "../lib/generated"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

// Auth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AnalysisHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 'analysis' | 'match'
  title     String
  score     Float
  data      Json // Full result data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum Role {
  USER
  ADMIN
  RECRUITER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  credits       Float     @default(20) // Utilisation de Float pour supporter les retraits de 0.5
  acceptsMarketing Boolean @default(false) // Opt-in pour les newsletters et alertes
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Professional Infos
  phone    String?
  jobTitle String?
  sector   String?

  // Referral System
  referralCode  String?   @unique // Unique 8-char code for sharing
  referredById  String? // ID of the user who referred this user
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id])
  referredUsers User[]    @relation("Referrals") // Users this user has referred
  referralCount Int       @default(0) // Count of successful referrals
  premiumUntil  DateTime? // Premium access expiry date (reward)

  // Recruiter-specific fields (populated when role = RECRUITER)
  companyName       String?
  recruiterCredits  Int       @default(0)
  freeUnlocksUsed   Int       @default(0) // Max 3 free unlocks

  accounts            Account[]
  sessions            Session[]
  cvs                 CV[]
  coverLetters        CoverLetter[]
  analyses            AnalysisHistory[]
  creditTransactions  CreditTransaction[]
  feedbacks           PlatformFeedback[]
  paymentTransactions PaymentTransaction[]
  interviewSessions   InterviewSession[]
  candidateProfiles   CandidateProfile[]
  profileUnlocks      ProfileUnlock[]
}

model PlatformFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int? // Optional 1-5 star rating
  content   String   @db.Text
  isVisible Boolean  @default(false) // Admin approval for public display
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PaymentTransaction {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId         String // "standard" | "premium" | "pro"
  amount         Int // Montant en FCFA
  credits        Int // Crédits à ajouter
  phone          String // Numéro du client (format international)
  status         String   @default("pending") // pending | completed | failed
  ligdicashToken String? // Token retourné par LigdiCash
  transactionId  String? // ID transaction LigdiCash
  operatorName   String? // "ORANGE BURKINA", etc.
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([ligdicashToken])
}

model CV {
  id           String   @id @default(cuid())
  title        String
  content      Json
  isPublic     Boolean  @default(false)
  isSearchable Boolean  @default(false)
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  candidateProfile CandidateProfile?

  @@index([userId])
  @@index([isSearchable])
}

model CoverLetter {
  id        String   @id @default(cuid())
  title     String
  content   Json // Stores the full cover letter data structure
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float // Montant de la transaction (négatif pour retrait, positif pour ajout)
  type        String // e.g., 'USAGE', 'PURCHASE', 'BONUS_REFERRAL', 'SIGNUP'
  description String // e.g., 'Génération Lettre Motivation IA'
  createdAt   DateTime @default(now())

  @@index([userId])
}

model AdminTask {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  status      String   @default("todo")
  priority    String   @default("medium")
  assignee    String?
  dueDate     DateTime?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InterviewSession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle      String
  jobContext    String?  @db.Text
  cvSummary     String   @db.Text
  status        String   @default("active")
  format        String   @default("text")
  voicePreference String?
  totalScore    Int?
  summary       String?  @db.Text
  questionCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      InterviewMessage[]

  @@index([userId])
}

model InterviewMessage {
  id         String   @id @default(cuid())
  sessionId  String
  session    InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String
  content    String   @db.Text
  score      Int?
  audioUrl   String?
  transcript String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([sessionId])
}

// Recruiter Portal Models

model CandidateProfile {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvId            String   @unique
  cv              CV       @relation(fields: [cvId], references: [id], onDelete: Cascade)

  anonymousName   String
  title           String
  summary         String?  @db.Text
  sector          String?
  skills          String[]
  experienceYears Int      @default(0)
  locationCity    String?
  locationCountry String?
  completionScore Int      @default(0)
  lastCvUpdate    DateTime
  anonymousData   Json?    @db.JsonB

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  unlocks         ProfileUnlock[]

  @@index([sector])
  @@index([experienceYears])
  @@index([completionScore])
  @@index([userId])
  @@index([isActive])
  @@index([locationCity])
  @@index([lastCvUpdate])
  @@index([isActive, completionScore, lastCvUpdate])
}

model ProfileUnlock {
  id                 String           @id @default(cuid())
  unlockerUserId     String
  unlockerUser       User             @relation(fields: [unlockerUserId], references: [id], onDelete: Cascade)
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  creditsCost        Int              @default(0)
  createdAt          DateTime         @default(now())

  @@unique([unlockerUserId, candidateProfileId])
  @@index([unlockerUserId])
  @@index([candidateProfileId])
}
