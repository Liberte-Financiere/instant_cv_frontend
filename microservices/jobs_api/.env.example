# Jobsira Opportunity API - Environment Variables

# Base de donnees Neon (lecture seule)
NEON_DB=postgres://user:pass@ep-xxx.neon.tech/opportunities?sslmode=require

# Serveur
PORT=8080
ENVIRONMENT=production

# Securite
API_KEY=change-me-to-a-strong-secret
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,https://jobsira.com

# Cache TTL (durees Go: 5m, 15m, 30m, 1h)
CACHE_TTL_DEFAULT=5m
CACHE_TTL_FILTERS=30m
CACHE_TTL_STATS=15m
